  // ============================================================================
  function buildBaselineData() {
    const baseInspections = [];
    const kurangSchedule = {
      "2026-11-01_TLT-01": ["Lantai", "Tissue"], // Critical (2 KURANG)
      "2026-11-01_LKR-01": ["Bau"],
      "2026-11-02_MSL-01": ["Bau"],
