  function renderDashboard() {
    const areaFilter = document.getElementById("dashFilterArea").value;
    const totalEmp = Math.max(1, Number(document.getElementById("dashTotalEmp").value) || 1000);

    const filIns = areaFilter === "Semua" ? inspections : inspections.filter(i => i.areaCode === areaFilter);
    const filCmp = areaFilter === "Semua" ? complaints : complaints.filter(c => c.areaCode === areaFilter);

    const goodCnt = filIns.filter(i => i.condition === "Good").length;
    const warnCnt = filIns.filter(i => i.condition === "Need Attention").length;
    const critCnt = filIns.filter(i => i.condition === "Critical").length;

    const openCmp = filCmp.filter(c => c.status !== "Closed").length;
    const closedCmps = filCmp.filter(c => c.status === "Closed");
    const onTimeCmps = closedCmps.filter(c => c.slaStatus === "ON TIME").length;
    const repeatCmps = filCmp.filter(c => c.repeatComplaint === "Yes").length;

    const validRes = closedCmps.map(c => Number(c.resolutionHours)).filter(v => !isNaN(v) && v > 0);
    const avgRes = validRes.length > 0 ? (validRes.reduce((a, b) => a + b, 0) / validRes.length).toFixed(2) : "0.00";
    const slaPct = closedCmps.length > 0 ? ((onTimeCmps / closedCmps.length) * 100).toFixed(1) + "%" : "100%";
    const cmpRate = ((filCmp.length / totalEmp) * 100).toFixed(2);

    document.getElementById("kpiGood").innerText = goodCnt;
    document.getElementById("kpiWarn").innerText = warnCnt;
    document.getElementById("kpiCrit").innerText = critCnt;
    document.getElementById("kpiOpenCmp").innerText = openCmp;
    document.getElementById("kpiClosedCmpSub").innerText = `Closed: ${closedCmps.length}`;
    document.getElementById("kpiCmpRate").innerText = cmpRate;
    document.getElementById("kpiAvgRes").innerText = `${avgRes} Jam`;
    document.getElementById("kpiSlaPct").innerText = slaPct;
    document.getElementById("kpiRepeat").innerText = repeatCmps;

    const areaBody = document.getElementById("areaSummaryBody");
    areaBody.innerHTML = MASTER_AREAS.map(a => {
      const aIns = inspections.filter(i => i.areaCode === a.code);
      const g = aIns.filter(i => i.condition === "Good").length;
      const w = aIns.filter(i => i.condition === "Need Attention").length;
      const cr = aIns.filter(i => i.condition === "Critical").length;
      const op = aIns.filter(i => i.slaStatus === "OPEN").length;
      const compPct = aIns.length > 0 ? ((g / aIns.length) * 100).toFixed(1) + "%" : "0.0%";
      return `
        <tr>
          <td><strong>${a.code}</strong></td>
          <td>${a.name}</td>
          <td>${aIns.length}</td>
          <td><span class="badge badge-good">${g}</span></td>
          <td><span class="badge badge-warn">${w}</span></td>
          <td><span class="badge badge-crit">${cr}</span></td>
          <td>${op}</td>
          <td><strong>${compPct}</strong></td>
        </tr>
      `;
    }).join("");

    const kurangCounts = PARAMETERS.map(p => ({
      param: p,
      count: filIns.filter(i => i.params && i.params[p] === "KURANG").length
    }));
    const maxKurang = Math.max(1, ...kurangCounts.map(x => x.count));
    document.getElementById("paramChartBox").innerHTML = kurangCounts.map(x => `
      <div class="bar-row">
        <div class="bar-label">${x.param}</div>
        <div class="bar-track"><div class="bar-fill" style="width:${(x.count / maxKurang) * 100}%"></div></div>
        <div class="bar-count">${x.count} KURANG</div>
      </div>
    `).join("");
  }

