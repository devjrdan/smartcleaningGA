  function initSyncStatus() {
    const url = getActiveWebhookUrl();
    const q = getSyncQueue();
    if (!url) updateSyncIndicator("", "Excel: Lokal");
    else if (q.length > 0) updateSyncIndicator("error", `Excel: ${q.length} Pending`);
    else updateSyncIndicator("connected", "Excel: Aktif");
  }

  async function pushToPowerAutomate(actionType, payloadObj) {
    const url = getActiveWebhookUrl();
    const fullPayload = { actionType, syncedAt: formatDateTime(new Date()), ...payloadObj };
    if (!url) return { ok: true, localOnly: true };

    updateSyncIndicator("syncing", "Syncing...");
    try {
      const res = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(fullPayload)
      });
      if (!res.ok) throw new Error("HTTP " + res.status);
      updateSyncIndicator("connected", "Excel: Terkirim");
      return { ok: true };
    } catch (err) {
      const q = getSyncQueue();
      q.push(fullPayload);
      setSyncQueue(q);
      updateSyncIndicator("error", `Excel: ${q.length} Pending`);
      return { ok: false, queued: true };
    }
  }

  async function flushSyncQueue() {
    const url = getActiveWebhookUrl();
    if (!url) return showToast("Isi URL Power Automate terlebih dahulu.");
    const q = getSyncQueue();
    if (q.length === 0) return showToast("Tidak ada antrean tertunda.");

    const remaining = [];
    for (const item of q) {
      try {
        const res = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(item)
        });
        if (!res.ok) remaining.push(item);
      } catch (e) { remaining.push(item); }
    }
    setSyncQueue(remaining);
    initSyncStatus();
    showToast(remaining.length === 0 ? "Semua antrean terkirim ke Excel!" : `${remaining.length} data masih gagal terkirim.`);
  }

