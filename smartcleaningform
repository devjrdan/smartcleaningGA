  async function saveTicketUpdate(e) {
    e.preventDefault();
    const id = document.getElementById("editTicketId").value;
    const t = complaints.find(c => c.id === id);
    if (!t) return;

    const newStatus = document.getElementById("editTicketStatus").value;
    t.status = newStatus;
    t.pic = document.getElementById("editTicketPic").value;
    t.rootCause = document.getElementById("editTicketRootCause").value.trim();
    t.correctiveAction = document.getElementById("editTicketAction").value.trim();

    if (newStatus === "Closed") {
      const now = new Date();
      t.actualClose = formatDateTime(now);
      const startMs = new Date(t.timestamp.replace(" ", "T")).getTime();
      const targetMs = new Date(t.targetClose.replace(" ", "T")).getTime();
      const diffHrs = Math.max(0.05, (now.getTime() - startMs) / 3600000);
      t.resolutionHours = Number(diffHrs.toFixed(2));
      t.slaStatus = now.getTime() <= targetMs ? "ON TIME" : "OVERDUE";
    }

    saveState();
    closeTicketModal();
    renderAll();

    await pushToPowerAutomate("UPDATE_COMPLAINT", t);
    showToast(`Tiket ${id} diperbarui (${newStatus}).`);
  }

