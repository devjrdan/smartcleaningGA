  function exportCsv() {
    let csv = "=== DATA COMPLAINT ===\n";
    csv += "Complaint ID,Tanggal & Jam,Pelapor,Department,Kode Area,Nama Area,Kategori,Deskripsi,Prioritas,Status,PIC,Target Close,Actual Close,Resolution Hours,SLA Status,Root Cause,Corrective Action,Repeat\n";
    complaints.forEach(c => {
      csv += `"${c.id}","${c.timestamp}","${c.reporter}","${c.department}","${c.areaCode}","${c.areaName}","${c.category}","${c.description}","${c.priority}","${c.status}","${c.pic}","${c.targetClose}","${c.actualClose}","${c.resolutionHours ?? ''}","${c.slaStatus}","${c.rootCause}","${c.correctiveAction}","${c.repeatComplaint}"\n`;
    });

    csv += "\n=== DATA INSPECTION ===\n";
    csv += "Inspection ID,Tanggal,Jam,Shift,Kode Area,Nama Area,Inspector,Lantai,Wastafel,Toilet,Tissue,Sabun,Bau,Tempat Sampah,Keran,Lampu,Jumlah Temuan,Facility Condition,Finding Detail,Action,PIC,Due Date,Closed Date,SLA Status\n";
    inspections.forEach(i => {
      const p = i.params || {};
      csv += `"${i.id}","${i.date}","${i.time}","${i.shift}","${i.areaCode}","${i.areaName}","${i.inspector}","${p.Lantai}","${p.Wastafel}","${p.Toilet}","${p.Tissue}","${p.Sabun}","${p.Bau}","${p['Tempat Sampah']}","${p.Keran}","${p.Lampu}","${i.kurangCount}","${i.condition}","${i.findingDetail}","${i.action}","${i.picAction}","${i.dueDate}","${i.closedDate}","${i.slaStatus}"\n`;
    });

    const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `GA_Smart_Cleaning_Export_${formatDateOnly(new Date())}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  }

  function renderAll() {
    const openCount = complaints.filter(c => c.status !== "Closed").length;
    document.getElementById("openTicketBadge").innerText = openCount;
    renderTickets();
    renderDashboard();
  }

  // ============================================================================
  // 8. INITIALIZATION ON PAGE LOAD
  // ============================================================================
  window.addEventListener("DOMContentLoaded", () => {
    loadState();
    populatePicDropdowns();

    const headerSel = document.getElementById("headerAreaSelect");
    const dashSel = document.getElementById("dashFilterArea");
    MASTER_AREAS.forEach(a => {
      headerSel.add(new Option(`${a.code} - ${a.name}`, a.code));
      dashSel.add(new Option(`${a.code} - ${a.name}`, a.code));
    });

    const params = new URLSearchParams(window.location.search);
    const qrArea = params.get("area");
    if (qrArea && MASTER_AREAS.some(a => a.code.toUpperCase() === qrArea.toUpperCase())) {
      selectArea(qrArea.toUpperCase());
    } else {
      selectArea("TLT-01");
    }

    setAllParams("BAIK");
    updateSlaBadge();
    initSyncStatus();
    renderQrStickers();
    renderAll();

    // Restore role session jika petugas/admin sudah membuka akses di shift ini
    const savedRole = sessionStorage.getItem(STORAGE_KEYS.ACTIVE_ROLE);
    if (savedRole === "STAFF" || savedRole === "ADMIN") {
      applyRoleUI(savedRole);
    } else {
      applyRoleUI("EMPLOYEE");
    }
  });
</script>
</body>
