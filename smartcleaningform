    const priority = document.getElementById("cmpPriority").value;
    const category = document.getElementById("cmpCategory").value;
    const targetDate = new Date(now.getTime() + (SLA_HOURS[priority] || 8) * 3600000);

    const nextNum = complaints.length + 1;
    const newId = `CMP-${String(nextNum).padStart(3, "0")}`;
    const isRepeat = complaints.some(c => c.areaCode === area.code && c.category === category) ? "Yes" : "No";
    const photoInput = document.getElementById("cmpPhoto");
    const photoLabel = photoInput.files && photoInput.files[0] ? `Photo: ${photoInput.files[0].name}` : "";

    const record = {
      id: newId,
      timestamp: formatDateTime(now),
      reporter: document.getElementById("cmpReporter").value.trim(),
      department: document.getElementById("cmpDept").value,
      areaCode: area.code,
      areaName: area.name,
      category,
      description: document.getElementById("cmpDesc").value.trim(),
      priority,
      status: "Open",
      pic: document.getElementById("cmpPic").value,
      targetClose: formatDateTime(targetDate),
      actualClose: "",
      resolutionHours: null,
      slaStatus: "OPEN",
      rootCause: "",
      correctiveAction: "",
      repeatComplaint: isRepeat,
      evidence: photoLabel
    };

    complaints.unshift(record);
    saveState();
    renderAll();

    document.getElementById("cmpDesc").value = "";
    document.getElementById("cmpPhoto").value = "";

    const syncRes = await pushToPowerAutomate("NEW_COMPLAINT", record);
    showToast(syncRes.ok && !syncRes.localOnly ? `Laporan ${newId} terkirim ke GA & Excel!` : `Laporan ${newId} berhasil dicatat.`);
  }

  async function submitInspection(e) {
    e.preventDefault();
    const area = getArea(currentAreaCode);
    const now = new Date();
    const tomorrow = new Date(now.getTime() + 24 * 3600000);

    const kurangItems = PARAMETERS.filter(p => currentParamState[p] === "KURANG");
    const kurangCount = kurangItems.length;
    const condition = kurangCount === 0 ? "Good" : (kurangCount === 1 ? "Need Attention" : "Critical");

    const ymd = formatDateOnly(now).replace(/-/g, "");
    const seq = String(inspections.length + 1).padStart(2, "0");
    const newId = `INS-${ymd}-${seq}`;

    const record = {
      id: newId,
      date: formatDateOnly(now),
      time: formatTimeOnly(now),
      shift: document.getElementById("insShift").value,
      areaCode: area.code,
      areaName: area.name,
      inspector: document.getElementById("insInspector").value,
      params: { ...currentParamState },
      kurangCount,
      condition,
      findingDetail: kurangCount > 0 ? (document.getElementById("insFindingDetail").value.trim() || `KURANG: ${kurangItems.join(", ")}`) : "-",
      action: kurangCount > 0 ? (document.getElementById("insActionPlan").value.trim() || "Cleaning ulang / perbaikan") : "Monitor",
      picAction: document.getElementById("insPicAction").value,
      dueDate: formatDateOnly(tomorrow),
      closedDate: kurangCount === 0 ? formatDateOnly(now) : "",
      slaStatus: kurangCount === 0 ? "OK" : "OPEN",
      evidence: document.getElementById("insEvidence").value.trim()
    };

    inspections.unshift(record);
    saveState();
    setAllParams("BAIK");
    document.getElementById("insEvidence").value = "";
    renderAll();

    const syncRes = await pushToPowerAutomate("NEW_INSPECTION", {
      ...record,
      Lantai: record.params["Lantai"],
      Wastafel: record.params["Wastafel"],
      Toilet: record.params["Toilet"],
      Tissue: record.params["Tissue"],
      Sabun: record.params["Sabun"],
      Bau: record.params["Bau"],
      TempatSampah: record.params["Tempat Sampah"],
      Keran: record.params["Keran"],
      Lampu: record.params["Lampu"]
    });

    showToast(syncRes.ok && !syncRes.localOnly ? `Inspeksi ${newId} (${condition}) masuk ke Excel!` : `Inspeksi ${newId} (${condition}) disimpan.`);
  }

