      "2026-11-09_LKR-01": ["Bau"],
      "2026-11-10_PUB-01": ["Wastafel"]
    };

    for (let day = 1; day <= 10; day++) {
      const dd = String(day).padStart(2, "0");
      const dateStr = `2026-11-${dd}`;
      const nextDateStr = `2026-11-${String(day + 1).padStart(2, "0")}`;

      MASTER_AREAS.forEach((area, idx) => {
        const key = `${dateStr}_${area.code}`;
        const kurangItems = kurangSchedule[key] || [];
        const params = {};
        PARAMETERS.forEach(p => {
          params[p] = kurangItems.includes(p) ? "KURANG" : "BAIK";
        });
        const kurangCount = kurangItems.length;
        const cond = kurangCount === 0 ? "Good" : (kurangCount === 1 ? "Need Attention" : "Critical");

        baseInspections.push({
          id: `INS-202611${dd}-0${idx + 1}`,
          date: dateStr,
          time: "08:00",
          shift: "Shift 1",
          areaCode: area.code,
          areaName: area.name,
          inspector: area.pic,
          params,
          kurangCount,
          condition: cond,
          findingDetail: kurangCount > 0 ? `Temuan KURANG pada: ${kurangItems.join(", ")}` : "-",
          action: kurangCount > 0 ? "Cleaning ulang / perbaikan" : "Monitor",
          picAction: "GA/Housekeeping",
          dueDate: nextDateStr,
          closedDate: kurangCount === 0 ? dateStr : "",
          slaStatus: kurangCount === 0 ? "OK" : "OPEN",
          evidence: ""
        });
      });
    }

    const baseComplaints = [
      {
        id: "CMP-001", timestamp: "2026-11-02 09:10:00", reporter: "User 001", department: "Production",
        areaCode: "TLT-01", areaName: "Toilet Produksi A", category: "Tissue", description: "Tissue habis",
        priority: "Medium", status: "Closed", pic: "Cleaning 1", targetClose: "2026-11-02 11:00:00",
        actualClose: "2026-11-02 09:40:00", resolutionHours: 0.5, slaStatus: "ON TIME",
        rootCause: "Replenishment terlambat", correctiveAction: "Tambah safety stock", repeatComplaint: "No"
      },
      {
        id: "CMP-002", timestamp: "2026-11-03 10:00:00", reporter: "User 002", department: "Quality",
        areaCode: "TLT-02", areaName: "Toilet Produksi B", category: "Bau", description: "Bau tidak nyaman",
        priority: "High", status: "Closed", pic: "Cleaning 2", targetClose: "2026-11-03 12:00:00",
        actualClose: "2026-11-03 11:30:00", resolutionHours: 1.5, slaStatus: "ON TIME",
        rootCause: "Drain kotor", correctiveAction: "Deep cleaning", repeatComplaint: "No"
      },
      {
        id: "CMP-003", timestamp: "2026-11-05 08:20:00", reporter: "User 003", department: "HR",
        areaCode: "TLT-03", areaName: "Toilet Office", category: "Keran", description: "Keran bocor",
        priority: "High", status: "In Progress", pic: "GA Maintenance", targetClose: "2026-11-05 16:00:00",
        actualClose: "", resolutionHours: null, slaStatus: "OPEN",
        rootCause: "Seal rusak", correctiveAction: "Ganti seal", repeatComplaint: "Yes"
      },
      {
        id: "CMP-004", timestamp: "2026-11-06 12:30:00", reporter: "User 004", department: "Production",
        areaCode: "CAN-01", areaName: "Kantin Utama", category: "Tempat Sampah", description: "Tempat sampah penuh",
        priority: "Medium", status: "Closed", pic: "Cleaning 4", targetClose: "2026-11-06 14:00:00",
        actualClose: "2026-11-06 13:10:00", resolutionHours: 0.67, slaStatus: "ON TIME",
        rootCause: "Frekuensi kurang", correctiveAction: "Tambah jadwal pickup", repeatComplaint: "No"
      },
      {
        id: "CMP-005", timestamp: "2026-11-08 15:00:00", reporter: "User 005", department: "Engineering",
        areaCode: "LKR-01", areaName: "Locker Room", category: "Lampu", description: "Lampu mati",
        priority: "Low", status: "Open", pic: "GA Maintenance", targetClose: "2026-11-09 12:00:00",
        actualClose: "", resolutionHours: null, slaStatus: "OPEN",
        rootCause: "Belum dicek", correctiveAction: "Penggantian lampu", repeatComplaint: "No"
      }
    ];

    return { baseInspections, baseComplaints };
  }

  function loadState() {
    const savedIns = localStorage.getItem(STORAGE_KEYS.INSPECTIONS);
    const savedCmp = localStorage.getItem(STORAGE_KEYS.COMPLAINTS);
    if (savedIns && savedCmp) {
      inspections = JSON.parse(savedIns);
      complaints = JSON.parse(savedCmp);
    } else {
      const { baseInspections, baseComplaints } = buildBaselineData();
      inspections = baseInspections;
      complaints = baseComplaints;
      saveState();
    }
  }

  function saveState() {
    localStorage.setItem(STORAGE_KEYS.INSPECTIONS, JSON.stringify(inspections));
    localStorage.setItem(STORAGE_KEYS.COMPLAINTS, JSON.stringify(complaints));
  }

  function resetToBaseline() {
    if (!confirm("Reset semua data ke 70 inspeksi & 5 komplain simulasi awal?")) return;
    const { baseInspections, baseComplaints } = buildBaselineData();
    inspections = baseInspections;
    complaints = baseComplaints;
    saveState();
    renderAll();
    showToast("Data simulasi awal dipulihkan.");
  }

  // ============================================================================
  // 3. SISTEM 3 ROLE & PIN GATE (KARYAWAN / PETUGAS / ADMIN GA)
  // ============================================================================
  function applyRoleUI(role) {
    currentRole = role;
    sessionStorage.setItem(STORAGE_KEYS.ACTIVE_ROLE, role);

    const roleBtn = document.getElementById("roleToggleBtn");
    const roleLabel = document.getElementById("roleLabel");
    const syncBtn = document.getElementById("headerSyncBtn");
    const tabQr = document.getElementById("tabBtnQr");
    const tabTickets = document.getElementById("tabBtnTickets");
    const tabDash = document.getElementById("tabBtnDashboard");
    const modeSwitch = document.getElementById("staffModeSwitch");

    roleBtn.classList.remove("staff-active", "admin-active");

    if (role === "EMPLOYEE") {
      roleLabel.innerText = "Mode Petugas / Admin";
      syncBtn.style.display = "none";
      tabQr.innerText = "1. Lapor Masalah Fasilitas";
      tabTickets.style.display = "none";
      tabDash.style.display = "none";
      modeSwitch.style.display = "none";
      setQrMode("complaint");
      switchTab("view-qr");
    } else if (role === "STAFF") {
      roleBtn.classList.add("staff-active");
      roleLabel.innerText = "Petugas (Keluar)";
      syncBtn.style.display = "none";
      tabQr.innerText = "1. QR Portal (Inspeksi / Lapor)";
      tabTickets.style.display = "inline-block";
      tabDash.style.display = "none";
      modeSwitch.style.display = "grid";
      setQrMode("inspection");
    } else if (role === "ADMIN") {
      roleBtn.classList.add("admin-active");
      roleLabel.innerText = "Admin GA (Keluar)";
      syncBtn.style.display = "inline-flex";
      tabQr.innerText = "1. QR Portal (Inspeksi / Lapor)";
      tabTickets.style.display = "inline-block";
      tabDash.style.display = "inline-block";
      modeSwitch.style.display = "grid";
    }
  }

  function handleRoleButtonClick() {
    if (currentRole === "EMPLOYEE") {
      document.getElementById("pinInput").value = "";
      document.getElementById("pinModal").classList.add("open");
      setTimeout(() => document.getElementById("pinInput").focus(), 100);
    } else {
      applyRoleUI("EMPLOYEE");
      showToast("Kembali ke Mode Karyawan (Pelapor).");
    }
  }

  function closePinModal() {
    document.getElementById("pinModal").classList.remove("open");
  }

  function submitPinUnlock(e) {
    e.preventDefault();
    const entered = document.getElementById("pinInput").value.trim();
    if (entered === ROLE_PINS.ADMIN) {
      closePinModal();
      applyRoleUI("ADMIN");
      showToast("Berhasil masuk sebagai Admin GA.");
    } else if (entered === ROLE_PINS.STAFF) {
      closePinModal();
      applyRoleUI("STAFF");
      showToast("Berhasil masuk sebagai Petugas Cleaning / Maintenance.");
    } else {
      alert("PIN salah. Hubungi Admin GA untuk mendapatkan PIN Petugas.");
    }
  }

  // ============================================================================
  // 4. POWER AUTOMATE / EXCEL WEBHOOK ENGINE
  // ============================================================================
  function getActiveWebhookUrl() {
    const savedUrl = localStorage.getItem(STORAGE_KEYS.WEBHOOK_URL);
    if (savedUrl && savedUrl.trim() !== "") return savedUrl.trim();
    return MS_WEBHOOK_URL.trim();
  }

  function getSyncQueue() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEYS.SYNC_QUEUE) || "[]"); }
    catch (e) { return []; }
  }

  function setSyncQueue(q) {
    localStorage.setItem(STORAGE_KEYS.SYNC_QUEUE, JSON.stringify(q));
    document.getElementById("pendingQueueCount").innerText = q.length;
  }

  function updateSyncIndicator(state, label) {
    document.getElementById("syncDot").className = "sync-dot " + (state || "");
    document.getElementById("syncText").innerText = label;
